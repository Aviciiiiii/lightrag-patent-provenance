{
  "nodes": [
    {
      "entity_id": "US8509827B2",
      "entity_type": "content",
      "description": "A patent document titled \"Methods and apparatus of context-data acquisition and ranking\" that discloses a system, method, and article of manufacture for acquiring and ranking context data based on a query derived from a short message.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331528,
      "truncate": "",
      "id": "US8509827B2"
    },
    {
      "entity_id": "Context-Data Acquisition And Ranking",
      "entity_type": "method",
      "description": "A method and system for determining a context-data type from a query, identifying context-data sources, ranking sources by specified parameters such as pecuniary cost, and generating requests for context data.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331528,
      "truncate": "",
      "id": "Context-Data Acquisition And Ranking"
    },
    {
      "entity_id": "Context-Data Type",
      "entity_type": "concept",
      "description": "A classification of context data determined algorithmically from the meaning of a term of a short message, providing information about the environment or context of a mobile device.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331528,
      "truncate": "",
      "id": "Context-Data Type"
    },
    {
      "entity_id": "Context-Data Source",
      "entity_type": "data",
      "description": "A source that provides a particular context-data type and from which context data is requested and acquired.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331528,
      "truncate": "",
      "id": "Context-Data Source"
    },
    {
      "entity_id": "Short Message",
      "entity_type": "content",
      "description": "A message whose content has a meaning to which context-data is related, and to which relevant context data is linked.<SEP>A message received from a mobile device whose terms are analyzed to determine a context-data type; context data may be appended to or associated with it.",
      "source_id": "US8509827B2-chunk-000<SEP>US8509827B2-chunk-001",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331528,
      "truncate": "",
      "id": "Short Message"
    },
    {
      "entity_id": "Mobile Device",
      "entity_type": "artifact",
      "description": "A device that generates a short message and a query, and to which received context data may be provided; may be a smart phone.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331528,
      "truncate": "",
      "id": "Mobile Device"
    },
    {
      "entity_id": "Server",
      "entity_type": "artifact",
      "description": "A computing device used to collect a set of context-data from at least one context-data provider.<SEP>A computing system that receives short messages, determines context-data types, identifies and ranks context-data sources, and generates requests for context data.",
      "source_id": "US8509827B2-chunk-000<SEP>US8509827B2-chunk-001",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331528,
      "truncate": "",
      "id": "Server"
    },
    {
      "entity_id": "Recipient Mobile Device",
      "entity_type": "artifact",
      "description": "A mobile device that receives context data, possibly appended to or associated with a short message, or via a database URI.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331528,
      "truncate": "",
      "id": "Recipient Mobile Device"
    },
    {
      "entity_id": "Specified Parameter",
      "entity_type": "concept",
      "description": "A criterion used to rank context-data sources, comprising a pecuniary cost to acquire context data, a state of the receiving mobile device, a state of an available communication network, or a cost value of the context data.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331528,
      "truncate": "",
      "id": "Specified Parameter"
    },
    {
      "entity_id": "Database",
      "entity_type": "artifact",
      "description": "A storage system available to a recipient mobile device in which received context data may be stored and queried.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331528,
      "truncate": "",
      "id": "Database"
    },
    {
      "entity_id": "Uniform Resource Identifier",
      "entity_type": "concept",
      "description": "An identifier of a database server that may be forwarded to a receiving mobile device to access stored context data.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331528,
      "truncate": "",
      "id": "Uniform Resource Identifier"
    },
    {
      "entity_id": "Markup Language",
      "entity_type": "concept",
      "description": "A language used to encode received context data into a short message.",
      "source_id": "US8509827B2-chunk-000",
