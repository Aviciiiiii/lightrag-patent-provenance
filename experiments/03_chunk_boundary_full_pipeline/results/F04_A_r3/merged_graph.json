{
  "nodes": [
    {
      "entity_id": "US8509827B2",
      "entity_type": "content",
      "description": "A patent publication titled \"Methods and apparatus of context-data acquisition and ranking\" that discloses a system, method, and article of manufacture for acquiring and ranking context data based on a query derived from a short message.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331730,
      "truncate": "",
      "id": "US8509827B2"
    },
    {
      "entity_id": "Context-Data Acquisition And Ranking",
      "entity_type": "method",
      "description": "A method and system for determining a context-data type from a query, identifying context-data sources, ranking sources by specified parameters such as pecuniary cost, and generating requests for context data.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331730,
      "truncate": "",
      "id": "Context-Data Acquisition And Ranking"
    },
    {
      "entity_id": "Context-Data Type",
      "entity_type": "concept",
      "description": "A classification of context data determined algorithmically from the meaning of a term in a short message, providing information about the environment or context of a mobile device.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331730,
      "truncate": "",
      "id": "Context-Data Type"
    },
    {
      "entity_id": "Context-Data Source",
      "entity_type": "data",
      "description": "A provider that supplies context data of a particular context-data type; sources may be ranked according to specified parameters such as pecuniary cost.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331730,
      "truncate": "",
      "id": "Context-Data Source"
    },
    {
      "entity_id": "Short Message",
      "entity_type": "content",
      "description": "A message content whose meaning context-data is related to, and to which relevant context-data is linked and formatted.<SEP>A message received from a mobile device by a server, whose term meanings are used to determine a context-data type; context data may be appended to or encoded into the short message.",
      "source_id": "US8509827B2-chunk-000<SEP>US8509827B2-chunk-001",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331730,
      "truncate": "",
      "id": "Short Message"
    },
    {
      "entity_id": "Mobile Device",
      "entity_type": "artifact",
      "description": "A device that generates a short message and a query; may be a smart phone; context data may be provided to it or to a recipient mobile device.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331730,
      "truncate": "",
      "id": "Mobile Device"
    },
    {
      "entity_id": "Server",
      "entity_type": "artifact",
      "description": "A server used by the context-data provider to collect the set of context-data.<SEP>A computing system that receives short messages from mobile devices, determines context-data types, identifies and ranks context-data sources, and generates requests for context data.",
      "source_id": "US8509827B2-chunk-000<SEP>US8509827B2-chunk-001",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331730,
      "truncate": "",
      "id": "Server"
    },
    {
      "entity_id": "Recipient Mobile Device",
      "entity_type": "artifact",
      "description": "A mobile device that receives context data, possibly associated with or appended to a short message, or a URI of a database server.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331730,
      "truncate": "",
      "id": "Recipient Mobile Device"
    },
    {
      "entity_id": "Specified Parameter",
      "entity_type": "concept",
      "description": "A criterion used to rank context-data sources, comprising a pecuniary cost to acquire context data, a state of the receiving mobile device, a state of an available communication network, or a cost value of the context data.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331730,
      "truncate": "",
      "id": "Specified Parameter"
    },
    {
      "entity_id": "Pecuniary Cost",
      "entity_type": "concept",
      "description": "A monetary cost to acquire context data from a context-data source, used as a specified parameter for ranking context-data sources.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331730,
      "truncate": "",
      "id": "Pecuniary Cost"
    },
    {
      "entity_id": "Database",
      "entity_type": "artifact",
      "description": "A storage system available to a recipient mobile device in which received context data may be stored; a URI of a database server may be forwarded to the receiving mobile device.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331730,
      "truncate": "",
      "id": "Database"
    },
    {
      "entity_id": "Uniform Resource Identifier",
      "entity_type": "concept",
      "description": "A URI of a database server that may be forwarded to a receiving mobile device to access stored context data.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331730,
      "truncate": "",
      "id": "Uniform Resource Identifier"
    },
    {
