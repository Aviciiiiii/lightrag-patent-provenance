      "file_path": "US8509827B2.txt",
      "created_at": 1793331689,
      "truncate": "",
      "id": "Server"
    },
    {
      "entity_id": "Specified Parameter",
      "entity_type": "concept",
      "description": "A criterion used to rank context-data sources, including pecuniary cost to acquire context data, state of the receiving mobile device, state of an available communication network, and cost value of the context data.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331689,
      "truncate": "",
      "id": "Specified Parameter"
    },
    {
      "entity_id": "Pecuniary Cost",
      "entity_type": "concept",
      "description": "A monetary cost to acquire context data from a context-data source, used as a specified parameter for algorithmically ranking context-data sources.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331689,
      "truncate": "",
      "id": "Pecuniary Cost"
    },
    {
      "entity_id": "Recipient Mobile Device",
      "entity_type": "artifact",
      "description": "A mobile device that receives context data, which may be provided to it, stored in a database available to it, or forwarded a URI of a database server.",
