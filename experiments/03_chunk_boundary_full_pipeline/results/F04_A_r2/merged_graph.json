    {
      "entity_id": "US8509827B2",
      "entity_type": "content",
      "description": "A patent publication titled \"Methods and apparatus of context-data acquisition and ranking\" that discloses a system, method, and article of manufacture for acquiring and ranking context data based on a query derived from a short message.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331689,
      "truncate": "",
      "id": "US8509827B2"
    },
    {
      "entity_id": "Context-Data Acquisition And Ranking",
      "entity_type": "method",
      "description": "A method and system for determining a context-data type from a query, identifying context-data sources, ranking sources by specified parameters such as pecuniary cost, and generating requests for context data.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331689,
      "truncate": "",
      "id": "Context-Data Acquisition And Ranking"
    },
    {
      "entity_id": "Context-Data Type",
      "entity_type": "concept",
      "description": "A classification of context data determined algorithmically from the meaning of a term in a short message, providing information about the environment or context of a mobile device.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331689,
      "truncate": "",
      "id": "Context-Data Type"
    },
    {
      "entity_id": "Context-Data Source",
      "entity_type": "organization",
      "description": "A provider that supplies context data of a particular context-data type, which can be identified, ranked, and queried for context data.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331689,
      "truncate": "",
      "id": "Context-Data Source"
    },
    {
      "entity_id": "Short Message",
      "entity_type": "content",
      "description": "A message whose content has a meaning to which context-data is related, and to which relevant context-data is linked and formatted.<SEP>A message received from a mobile device, whose term meanings are used to determine a context-data type; context data may be associated with, appended to, encoded into, or forwarded with the short message.",
      "source_id": "US8509827B2-chunk-000<SEP>US8509827B2-chunk-001",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331689,
      "truncate": "",
      "id": "Short Message"
    },
    {
      "entity_id": "Mobile Device",
      "entity_type": "artifact",
      "description": "A device that generates and receives short messages and context data; may be a smart phone, and has states used as specified parameters for ranking context-data sources.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793331689,
      "truncate": "",
      "id": "Mobile Device"
    },
    {
      "entity_id": "Server",
      "entity_type": "artifact",
      "description": "A computing system used to collect a set of context-data from at least one context-data provider.<SEP>A computing system that receives short messages from mobile devices, determines context-data types, identifies and ranks context-data sources, and generates requests for context data.",
