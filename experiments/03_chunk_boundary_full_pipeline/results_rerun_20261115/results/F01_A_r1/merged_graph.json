    {
      "entity_id": "US9589231B2",
      "entity_type": "content",
      "description": "A patent document titled \"Social medical network for diagnosis assistance\" that describes a method and system for assisting medical diagnosis by exploiting similarity between new medical cases and existing cases and experts in a common embedding space.",
      "source_id": "US9589231B2-chunk-000",
      "file_path": "US9589231B2.txt",
