      "truncate": "",
      "id": "Social Medical Network For Diagnosis Assistance"
    },
    {
      "entity_id": "Diagnosis Assistance Method",
      "entity_type": "method",
      "description": "A method that receives a query request including a new medical case, embeds the new case in an embedding space containing existing medical cases and experts, allows selection between query-for-cases and query-for-experts, and returns subsets of cases or experts based on computed similarity.",
      "source_id": "US9589231B2-chunk-000",
      "file_path": "US9589231B2.txt",
      "created_at": 1794713499,
      "truncate": "",
      "id": "Diagnosis Assistance Method"
    },
    {
      "entity_id": "Embedding Space",
      "entity_type": "concept",
      "description": "A multidimensional space in which new medical cases, existing medical cases, and experts are represented as multidimensional embeddings for similarity computation.<SEP>A common multidimensional space in which new medical cases, existing medical cases, and experts are embedded so that similarity between their representations can be computed.",
      "source_id": "US9589231B2-chunk-000<SEP>US9589231B2-chunk-001",
      "file_path": "US9589231B2.txt",
      "created_at": 1794713499,
      "truncate": "",
      "id": "Embedding Space"
    },
    {
      "entity_id": "New Medical Case",
      "entity_type": "concept",
      "description": "A medical case submitted by a requester in a query request, comprising a plurality of records relating to a specific patient, which is embedded in the embedding space for comparison.",
