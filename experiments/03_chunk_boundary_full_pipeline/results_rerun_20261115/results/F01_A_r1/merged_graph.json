      "file_path": "US9589231B2.txt",
      "created_at": 1794713499,
      "truncate": "",
      "id": "New Medical Case"
    },
    {
      "entity_id": "Existing Medical Cases",
      "entity_type": "concept",
      "description": "A set of previously stored medical cases that are embedded in the embedding space and compared against a new medical case to return a similar subset.",
