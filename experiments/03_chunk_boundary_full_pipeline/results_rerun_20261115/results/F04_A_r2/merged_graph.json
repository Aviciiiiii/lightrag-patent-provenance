      "file_path": "US8509827B2.txt",
      "created_at": 1794714055,
      "truncate": "",
      "id": "Database"
    },
    {
      "entity_id": "Database Server",
      "entity_type": "artifact",
      "description": "A server whose Uniform Resource Identifier is forwarded to a receiving mobile device to allow access to stored context data.",
