{
  "nodes": [
    {
      "entity_id": "US8509827B2",
      "entity_type": "content",
      "description": "A patent publication titled \"Methods and apparatus of context-data acquisition and ranking\" that discloses a system, method, and article of manufacture for acquiring and ranking context data based on a query derived from a short message.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1794714055,
      "truncate": "",
      "id": "US8509827B2"
    },
    {
      "entity_id": "Context-Data Acquisition And Ranking",
      "entity_type": "method",
      "description": "A method of determining a context-data type from a query, identifying context-data sources providing that type, generating requests for context data, and ranking received context data according to a specified parameter.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1794714055,
      "truncate": "",
      "id": "Context-Data Acquisition And Ranking"
    },
    {
      "entity_id": "Context-Data Type",
      "entity_type": "concept",
      "description": "A classification of context data determined algorithmically from the meaning of a term of a short message, providing information about the environment or context of the mobile device.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1794714055,
      "truncate": "",
      "id": "Context-Data Type"
    },
    {
      "entity_id": "Context-Data Source",
      "entity_type": "data",
      "description": "A source that provides a particular context-data type and from which context data is requested and received; sources may be ranked according to a specified parameter such as pecuniary cost.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1794714055,
      "truncate": "",
      "id": "Context-Data Source"
    },
    {
      "entity_id": "Short Message",
      "entity_type": "content",
      "description": "A message whose content has a meaning and physical context, to which relevant context-data is linked and formatted according to a communication protocol.<SEP>A message received from a mobile device by a server, whose term meanings are used to determine a context-data type; context data may be associated with, appended to, encoded into, or forwarded with the short message.",
      "source_id": "US8509827B2-chunk-000<SEP>US8509827B2-chunk-001",
      "file_path": "US8509827B2.txt",
      "created_at": 1794714055,
      "truncate": "",
      "id": "Short Message"
    },
    {
      "entity_id": "Mobile Device",
      "entity_type": "artifact",
      "description": "A device that generates a short message and a query, receives context data, and may be a smart phone; its environment and state are described by the context-data type and specified parameters.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1794714055,
      "truncate": "",
      "id": "Mobile Device"
    },
    {
      "entity_id": "Server",
      "entity_type": "artifact",
      "description": "A computing device used by a context-data provider to collect context-data.<SEP>A computing system that receives short messages from mobile devices, determines context-data types, identifies and ranks context-data sources, and generates requests for context data.",
      "source_id": "US8509827B2-chunk-000<SEP>US8509827B2-chunk-001",
      "file_path": "US8509827B2.txt",
      "created_at": 1794714055,
      "truncate": "",
      "id": "Server"
    },
    {
      "entity_id": "Specified Parameter",
      "entity_type": "concept",
      "description": "A criterion used to rank context-data sources or select context data, comprising a pecuniary cost to acquire context data, a state of the receiving mobile device, a state of an available communication network, or a cost value of the context data.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1794714055,
      "truncate": "",
      "id": "Specified Parameter"
    },
    {
      "entity_id": "Recipient Mobile Device",
      "entity_type": "artifact",
      "description": "A mobile device that receives context data, possibly associated with a component of a short message, appended to the short message, or accessed via a database.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1794714055,
      "truncate": "",
      "id": "Recipient Mobile Device"
    },
    {
      "entity_id": "Database",
      "entity_type": "artifact",
      "description": "A storage system available to a recipient mobile device in which received context data is stored, accessible via a Uniform Resource Identifier of a database server and metadata instructions.",
