    {
      "entity_id": "US8509827B2",
      "entity_type": "content",
      "description": "A patent document titled \"Methods and apparatus of context-data acquisition and ranking\" that discloses a system, method, and article of manufacture for acquiring and ranking context data based on a query derived from a short message.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793894875,
      "truncate": "",
      "id": "US8509827B2"
    },
    {
      "entity_id": "Context-Data Acquisition And Ranking",
      "entity_type": "method",
      "description": "A method and system for determining a context-data type from a query, identifying context-data sources, ranking sources by specified parameters, and generating requests for context data.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793894875,
      "truncate": "",
      "id": "Context-Data Acquisition And Ranking"
    },
    {
      "entity_id": "Short Message",
      "entity_type": "content",
      "description": "A message whose content has a meaning to which context-data is related, and to which relevant context data is linked and formatted according to a communication protocol.<SEP>A message received from a mobile device whose terms are analyzed to determine a context-data type; context data may be appended, encoded, or associated with it.",
      "source_id": "US8509827B2-chunk-000<SEP>US8509827B2-chunk-001",
      "file_path": "US8509827B2.txt",
      "created_at": 1793894875,
      "truncate": "",
      "id": "Short Message"
    },
    {
      "entity_id": "Mobile Device",
      "entity_type": "artifact",
      "description": "A device that generates and receives short messages and queries; may be a smart phone; context data provides information about its environment or context.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793894875,
      "truncate": "",
      "id": "Mobile Device"
    },
    {
      "entity_id": "Server",
      "entity_type": "artifact",
      "description": "A computing device associated with a context-data provider that is used in collecting a set of context-data.<SEP>A computing system that receives short messages, determines context-data types, identifies and ranks context-data sources, and generates requests for context data.",
      "source_id": "US8509827B2-chunk-000<SEP>US8509827B2-chunk-001",
      "file_path": "US8509827B2.txt",
      "created_at": 1793894875,
      "truncate": "",
      "id": "Server"
    },
    {
      "entity_id": "Context-Data Type",
      "entity_type": "concept",
      "description": "A classification of context data determined by the meaning of a term of a short message, providing information about the environment or context of the mobile device.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793894875,
      "truncate": "",
      "id": "Context-Data Type"
    },
    {
      "entity_id": "Context-Data Source",
      "entity_type": "organization",
      "description": "A provider that supplies a particular context-data type; sources are identified and algorithmically ranked according to specified parameters such as pecuniary cost.",
      "source_id": "US8509827B2-chunk-000",
      "file_path": "US8509827B2.txt",
      "created_at": 1793894875,
      "truncate": "",
      "id": "Context-Data Source"
    },
    {
      "entity_id": "Context Data",
      "entity_type": "data",
      "description": "Information about the environment or context of a device, acquired from context-data sources and possibly ranked, stored, appended, or forwarded.",
