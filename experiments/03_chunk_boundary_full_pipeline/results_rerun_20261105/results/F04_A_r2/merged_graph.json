      "truncate": "",
      "id": "Server"
    },
    {
      "entity_id": "Specified Parameter",
      "entity_type": "concept",
      "description": "A criterion used to rank context-data sources, comprising a pecuniary cost to acquire context data, a state of the receiving mobile device, a state of an available communication network, or a cost value of the context data.",
