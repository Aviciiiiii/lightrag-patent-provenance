  "code_mechanisms": [
    {
      "source": "lightrag/constants.py",
      "line": 49,
      "finding": "GRAPH_FIELD_SEP is <SEP>; source IDs, descriptions and relation keys share this delimiter."
    },
    {
      "source": "lightrag/utils.py",
      "line": 6423,
      "finding": "merge_source_ids splits joined strings, trims whitespace, deduplicates by first-seen order. Joining is not a lossless per-description attribution structure."
    },
    {
      "source": "lightrag/operate.py",
      "line": 2489,
      "finding": "Entity merge prefers structurally valid entity_chunks tracking, writes full merged chunk IDs before limiting graph.source_id. An empty but present chunk_ids list is authoritative; graph fallback only when tracking schema is absent."
    },
    {
      "source": "lightrag/operate.py",
      "line": 2855,
      "finding": "Relation merge uses the same full-tracking-before-limit pattern; excludes historical UNKNOWN/manual_creation placeholders as non-evidence."
    },
    {
      "source": "lightrag/utils.py",
      "line": 6484,
      "finding": "source_id cap keeps oldest first-N in KEEP mode or newest last-N in FIFO mode. Defaults are 200 per entity and 200 per relation; graph/VDB can therefore omit sources while full KV tracking retains them."
    },
    {
      "source": "lightrag/operate.py",
      "line": 2633,
      "finding": "Entity file_path unions old/new paths, deduplicates, drops old placeholder while rebuilding; applies count cap (default75). KEEP keeps earliest paths; FIFO newest, adds ...truncated...(KEEP Old/FIFO). Stored path union is separate from source-id order."
    },
    {
      "source": "lightrag/operate.py",
      "line": 2698,
      "finding": "Node truncate records source-ID limiting (KEEP Old or FIFO kept/total). This field differs from generation finish_reason=length."
    },
    {
      "source": "lightrag/operate.py",
      "line": 3160,
      "finding": "Absent relation endpoints may be created as UNKNOWN nodes and inherit relation evidence; source membership is not proof that the entity was separately explicitly extracted."
    },
    {
      "source": "lightrag/operate.py",
      "line": 3665,
      "finding": "full_entities/full_relations write candidate supersets before graph mutation; candidates alone do not prove a final graph object or supported relation."
    },
    {
      "source": "lightrag/utils.py",
      "line": 6623,
      "finding": "make_relation_chunk_key sorts endpoints then joins with <SEP>; it loses direction by design because graph stores undirected entity-pair relations."
    }
  ],
  "configuration_caveat": "Saved full_settings does not record resolved max_source_ids/max_file_paths/limit_method, and run_experiment.py supplies no explicit override. Values200/200/75/KEEP above are official defaults, not a reconstructed secret/environment configuration. Actual completeness is established by persisted-set comparisons, independently of assumed defaults.",
  "authoritative_mapping_recommendation": [
    "For a node, use exact entity name -> kv_store_entity_chunks.chunk_ids -> kv_store_text_chunks[chunk_id].full_doc_id -> kv_store_full_docs[full_doc_id], and verify file_path/header.",
    "For an edge, use sorted endpoint pair -> kv_store_relation_chunks.chunk_ids -> text_chunks -> full_docs. Track full source sets even when graph.source_id or file_path is truncated.",
    "Use document recovery indexes as corroboration, not sole authoritative evidence. Never zip source_id tokens with file_path tokens positionally.",
    "Read original chunk/document content to assign individual descriptive statements, predicates or Claim numbers. Membership only records that a graph object was sourced from those chunks, not that every merged description clause is supported by every source."
  ],
  "limits": [
    "This audit checks mapping integrity, not semantic correctness of entity resolution or merged descriptions.",
    "A complete mapping does not establish explicit Claim structure; source_id identifies chunks, not Claim numbers or exact evidence spans.",
    "Current node/edge summaries can combine multiple descriptions without a clause-to-source linkage; text-level manual verification remains necessary.",
    "Truncation risks described are code mechanisms; empirical truncation presence/absence is reported separately from hypothetical future scale."
  ],
