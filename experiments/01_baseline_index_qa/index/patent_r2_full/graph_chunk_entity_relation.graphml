    <node id="Time-Decaying Weighted Frequency">
      <data key="d0">Time-Decaying Weighted Frequency</data>
      <data key="d1">concept</data>
      <data key="d2">A weighting scheme applied to the frequency of search keywords present in viewed pages, used as a basis for clustering.&lt;SEP&gt;A weighting of the frequency of search keywords present in viewed pages that decays over time, used as a basis for clustering.</data>
      <data key="d3">US8880423B2-chunk-000&lt;SEP&gt;US8880423B2-chunk-001</data>
      <data key="d4">US8880423B2.txt</data>
