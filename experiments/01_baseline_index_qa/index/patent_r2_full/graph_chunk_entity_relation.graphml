      <data key="d4">US8880423B2.txt</data>
      <data key="d5">1793284279</data>
      <data key="d6" />
    </node>
    <node id="Search Keyword">
      <data key="d0">Search Keyword</data>
      <data key="d1">concept</data>
      <data key="d2">Keywords previously submitted by users in searches performed prior to accessing viewed pages, used for clustering and for defining search retargeting segments.</data>
      <data key="d3">US8880423B2-chunk-000</data>
      <data key="d4">US8880423B2.txt</data>
      <data key="d5">1793284279</data>
