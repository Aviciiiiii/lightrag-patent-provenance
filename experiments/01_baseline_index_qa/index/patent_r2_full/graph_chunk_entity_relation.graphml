    <node id="Content Recommendation System">
      <data key="d0">Content Recommendation System</data>
      <data key="d1">method</data>
      <data key="d2">A system and method for recommending network content to users by associating a user preferred character with a recommended character via a library and relationship score.</data>
      <data key="d3">US9374411B1-chunk-000</data>
      <data key="d4">US9374411B1.txt</data>
      <data key="d5">1793284456</data>
      <data key="d6" />
    </node>
    <node id="Preferred Character">
      <data key="d0">Preferred Character</data>
      <data key="d1">concept</data>
      <data key="d2">A character represented in a first network content feature that a user has expressed a preference toward, represented by a corresponding first cast member.</data>
      <data key="d3">US9374411B1-chunk-000</data>
      <data key="d4">US9374411B1.txt</data>
      <data key="d5">1793284456</data>
      <data key="d6" />
    </node>
    <node id="Recommended Character">
      <data key="d0">Recommended Character</data>
      <data key="d1">concept</data>
      <data key="d2">A character represented in a second network content feature identified via a library based on the user preferred character, represented by a corresponding second cast member.&lt;SEP&gt;A character identified from the library based on the user preferred character and interaction data, represented in a second network content.</data>
      <data key="d3">US9374411B1-chunk-000&lt;SEP&gt;US9374411B1-chunk-001</data>
      <data key="d4">US9374411B1.txt</data>
      <data key="d5">1793284456</data>
      <data key="d6" />
    </node>
    <node id="Library">
      <data key="d0">Library</data>
      <data key="d1">data</data>
      <data key="d2">A data structure that associates preferred characters to recommended characters according to a relationship score.&lt;SEP&gt;A library that associates a user preferred character to a recommended character according to a relationship score.</data>
      <data key="d3">US9374411B1-chunk-000&lt;SEP&gt;US9374411B1-chunk-001</data>
      <data key="d4">US9374411B1.txt</data>
      <data key="d5">1793284456</data>
      <data key="d6" />
    </node>
    <node id="Relationship Score">
      <data key="d0">Relationship Score</data>
      <data key="d1">data</data>
      <data key="d2">A score calculated based at least in part upon a proportion of users who have expressed a preference towards both the preferred character and the recommended character, quantifying commonality between characters.&lt;SEP&gt;A score calculated based on the proportion of users who expressed a preference toward both the first and second characters, quantifying commonality between characters.&lt;SEP&gt;A score calculated based at least in part on the quantity of users expressing preference toward the first fictional character and on whether the two fictional characters are associated with a similar genre.</data>
      <data key="d3">US9374411B1-chunk-000&lt;SEP&gt;US9374411B1-chunk-001&lt;SEP&gt;US9374411B1-chunk-002</data>
      <data key="d4">US9374411B1.txt</data>
      <data key="d5">1793284456</data>
      <data key="d6" />
    </node>
    <node id="First Video Content Feature">
      <data key="d0">First Video Content Feature</data>
      <data key="d1">content</data>
      <data key="d2">A video content feature streamed from a server to a client and rendered in a user interface, containing scenes and cast members including the preferred character.&lt;SEP&gt;A video content feature associated with at least one scene in which a first character is identified.</data>
      <data key="d3">US9374411B1-chunk-000&lt;SEP&gt;US9374411B1-chunk-001</data>
      <data key="d4">US9374411B1.txt</data>
