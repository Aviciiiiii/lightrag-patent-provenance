    <node id="Physical Sensor">
      <data key="d0">Physical Sensor</data>
      <data key="d1">artifact</data>
      <data key="d2">A device by which the context-data is obtained.&lt;SEP&gt;A sensor by which context data related to the meaning of short message content is obtained.</data>
      <data key="d3">US8509827B2-chunk-000&lt;SEP&gt;US8509827B2-chunk-001</data>
      <data key="d4">US8509827B2.txt</data>
