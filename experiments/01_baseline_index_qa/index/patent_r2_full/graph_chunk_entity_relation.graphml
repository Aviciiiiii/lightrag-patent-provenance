    <node id="Cluster Probability Vector Processor">
      <data key="d0">Cluster Probability Vector Processor</data>
      <data key="d1">artifact</data>
      <data key="d2">A component of the advertisement inventory estimation system configured to cluster viewed pages and search keywords into clusters and generate page view probability vectors and keyword probability vectors.&lt;SEP&gt;A system component configured to cluster viewed pages into clusters to generate page view probability vectors.</data>
      <data key="d3">US8880423B2-chunk-000&lt;SEP&gt;US8880423B2-chunk-001</data>
      <data key="d4">US8880423B2.txt</data>
      <data key="d5">1793284279</data>
      <data key="d6" />
