      <data key="d1">artifact</data>
      <data key="d2">A type of mobile device that may generate the short message.</data>
      <data key="d3">US8509827B2-chunk-000</data>
      <data key="d4">US8509827B2.txt</data>
      <data key="d5">1793284123</data>
      <data key="d6" />
    </node>
    <node id="Communication Network">
      <data key="d0">Communication Network</data>
      <data key="d1">artifact</data>
      <data key="d2">A network through which context data may be communicated to a mobile device and whose state may serve as a specified parameter.&lt;SEP&gt;A network over which queries are received and responses transmitted electronically; may be the Internet.&lt;SEP&gt;A network such as the Internet over which queries are received electronically and responses are transmitted electronically to a party.&lt;SEP&gt;A network over which queries are received and responses transmitted electronically, which may be the Internet.</data>
      <data key="d3">US8509827B2-chunk-000&lt;SEP&gt;US7756837B2-chunk-000&lt;SEP&gt;US7756837B2-chunk-001&lt;SEP&gt;US7756837B2-chunk-002</data>
      <data key="d4">US8509827B2.txt&lt;SEP&gt;US7756837B2.txt</data>
      <data key="d5">1793284549</data>
      <data key="d6" />
    </node>
    <node id="Context-Data">
      <data key="d0">Context-Data</data>
      <data key="d1">data</data>
      <data key="d2">Data related to the meaning of a short message content, obtained by a physical sensor and provided by context-data providers, weighted and selected according to at least one metric.</data>
      <data key="d3">US8509827B2-chunk-001</data>
      <data key="d4">US8509827B2.txt</data>
      <data key="d5">1793284123</data>
      <data key="d6" />
    </node>
    <node id="Monetary Cost">
      <data key="d0">Monetary Cost</data>
      <data key="d1">concept</data>
      <data key="d2">The cost of the context-data, used as a metric for selecting relevant context data.</data>
      <data key="d3">US8509827B2-chunk-001</data>
      <data key="d4">US8509827B2.txt</data>
      <data key="d5">1793284123</data>
      <data key="d6" />
    </node>
    <node id="Communication Protocol">
      <data key="d0">Communication Protocol</data>
      <data key="d1">concept</data>
      <data key="d2">A protocol according to which the relevant context data and the short message are formatted, such as a cellular network short message protocol or an internet communication protocol.</data>
      <data key="d3">US8509827B2-chunk-001</data>
      <data key="d4">US8509827B2.txt</data>
