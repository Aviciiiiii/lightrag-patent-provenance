    <node id="Speaker Identification Using Hash-Based Indexing">
      <data key="d0">Speaker Identification Using Hash-Based Indexing</data>
      <data key="d1">content</data>
      <data key="d2">A patent (US9514753B2) describing methods, systems, and apparatus for performing speaker identification using hash-based indexing of speaker vectors.</data>
      <data key="d3">US9514753B2-chunk-000</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Utterance Vector">
      <data key="d0">Utterance Vector</data>
      <data key="d1">data</data>
      <data key="d2">A vector derived from an utterance, used as a query for comparing against speaker vectors.&lt;SEP&gt;A vector derived from an utterance, used as the query representation in speaker identification; may be an i-vector or based on deep neural network activations.</data>
      <data key="d3">US9514753B2-chunk-000&lt;SEP&gt;US9514753B2-chunk-001</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Speaker Vector">
      <data key="d0">Speaker Vector</data>
      <data key="d1">data</data>
      <data key="d2">A vector derived from one or more utterances of a respective speaker, used to characterize the speech of that speaker.&lt;SEP&gt;A vector derived from one or more utterances of a respective speaker, stored in hash tables and compared against an utterance vector to identify a speaker.</data>
      <data key="d3">US9514753B2-chunk-000&lt;SEP&gt;US9514753B2-chunk-001</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Hash Values">
      <data key="d0">Hash Values</data>
      <data key="d1">data</data>
      <data key="d2">Values determined for an utterance vector according to multiple different hash functions, used to retrieve candidate speaker vectors from hash tables.</data>
      <data key="d3">US9514753B2-chunk-000</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Hash Tables">
      <data key="d0">Hash Tables</data>
      <data key="d1">data</data>
      <data key="d2">A plurality of tables storing speaker vectors, indexed by hash values, from which a set of candidate speaker vectors is determined.</data>
      <data key="d3">US9514753B2-chunk-000</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Hash Functions">
      <data key="d0">Hash Functions</data>
      <data key="d1">method</data>
      <data key="d2">Multiple different functions used to compute hash values for vectors; may include locality sensitive hash functions and hyperplane-based hashing.</data>
      <data key="d3">US9514753B2-chunk-000</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Locality Sensitive Hash Functions">
      <data key="d0">Locality Sensitive Hash Functions</data>
      <data key="d1">method</data>
      <data key="d2">A type of hash function used to determine hash values such that similar vectors are likely to hash to similar values.</data>
      <data key="d3">US9514753B2-chunk-000</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Hyperplanes">
      <data key="d0">Hyperplanes</data>
      <data key="d1">concept</data>
      <data key="d2">Geometric constructs used to determine hash values based on the position of an utterance vector relative to different hyperplanes.</data>
      <data key="d3">US9514753B2-chunk-000</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="I-Vector">
      <data key="d0">I-Vector</data>
      <data key="d1">data</data>
      <data key="d2">A vector comprising parameters determined using multivariate factor analysis of an utterance or of one or more utterances of a respective speaker.&lt;SEP&gt;A vector comprising parameters determined using multivariate factor analysis of an utterance or of one or more utterances of a speaker.</data>
      <data key="d3">US9514753B2-chunk-000&lt;SEP&gt;US9514753B2-chunk-001</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Deep Neural Network">
      <data key="d0">Deep Neural Network</data>
      <data key="d1">artifact</data>
      <data key="d2">A neural network whose activations, occurring in response to information about an utterance, are used to determine vector parameters.</data>
      <data key="d3">US9514753B2-chunk-000</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Similarity Scores">
      <data key="d0">Similarity Scores</data>
      <data key="d1">data</data>
      <data key="d2">Scores each indicating a degree of similarity between the utterance vector and one of the speaker vectors in the set, used to select the most similar speaker vector.</data>
      <data key="d3">US9514753B2-chunk-000</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Cosine Distance">
      <data key="d0">Cosine Distance</data>
      <data key="d1">method</data>
      <data key="d2">A measure of distance between the utterance vector and each speaker vector in the set, used to determine similarity scores.</data>
      <data key="d3">US9514753B2-chunk-000</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Maximum Distance Threshold Value">
      <data key="d0">Maximum Distance Threshold Value</data>
      <data key="d1">data</data>
      <data key="d2">A threshold against which the smallest cosine distance is compared to decide whether to select a speaker vector.</data>
      <data key="d3">US9514753B2-chunk-000</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Speaker Identity">
      <data key="d0">Speaker Identity</data>
      <data key="d1">concept</data>
      <data key="d2">Data indicating the identity of a speaker, determined based on associations between speaker vectors and respective speakers.&lt;SEP&gt;The identity of a speaker determined from the selected speaker vector and output as data.</data>
      <data key="d3">US9514753B2-chunk-000&lt;SEP&gt;US9514753B2-chunk-001</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Media Items">
      <data key="d0">Media Items</data>
      <data key="d1">content</data>
      <data key="d2">Media items that include utterances of a speaker corresponding to the selected speaker vector and can be identified and output.</data>
      <data key="d3">US9514753B2-chunk-000</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Video Resources">
      <data key="d0">Video Resources</data>
      <data key="d1">content</data>
      <data key="d2">A set of multiple video resources from which speaker vectors are generated.</data>
      <data key="d3">US9514753B2-chunk-000</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="User Authentication">
      <data key="d0">User Authentication</data>
      <data key="d1">method</data>
      <data key="d2">A process of authenticating a particular user based at least in part on determining that the selected speaker vector corresponds to that user.</data>
      <data key="d3">US9514753B2-chunk-000</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Speaker">
      <data key="d0">Speaker</data>
      <data key="d1">person</data>
      <data key="d2">A person whose speech characteristics are represented by a speaker vector and who may be identified via a speaker identity.&lt;SEP&gt;A person whose utterances are represented by speaker vectors and whose identity is to be determined from an utterance.</data>
      <data key="d3">US9514753B2-chunk-000&lt;SEP&gt;US9514753B2-chunk-001</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Hash Table">
      <data key="d0">Hash Table</data>
      <data key="d1">data</data>
      <data key="d2">A data structure among a plurality of hash tables from which speaker vectors are determined using hash values.</data>
      <data key="d3">US9514753B2-chunk-001</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Hash Value">
      <data key="d0">Hash Value</data>
      <data key="d1">data</data>
      <data key="d2">A value determined for an utterance vector according to multiple different hash functions, used to look up speaker vectors in hash tables.</data>
      <data key="d3">US9514753B2-chunk-001</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Hash Function">
      <data key="d0">Hash Function</data>
      <data key="d1">method</data>
      <data key="d2">One of multiple different hash functions used to determine hash values for an utterance vector.</data>
      <data key="d3">US9514753B2-chunk-001</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Utterance">
      <data key="d0">Utterance</data>
      <data key="d1">data</data>
      <data key="d2">A spoken input from which an utterance vector is derived.</data>
      <data key="d3">US9514753B2-chunk-001</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Multivariate Factor Analysis">
      <data key="d0">Multivariate Factor Analysis</data>
      <data key="d1">method</data>
      <data key="d2">A technique used to determine parameters of utterance i-vectors and speaker i-vectors.</data>
      <data key="d3">US9514753B2-chunk-001</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Video Resource">
      <data key="d0">Video Resource</data>
      <data key="d1">content</data>
      <data key="d2">A video resource for which a speaker vector is generated, among a set of multiple video resources.</data>
      <data key="d3">US9514753B2-chunk-001</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="Computer-Readable Storage Device">
      <data key="d0">Computer-Readable Storage Device</data>
      <data key="d1">artifact</data>
      <data key="d2">A device storing instructions that, when executed by one or more computers, cause the computers to perform operations for speaker identification.&lt;SEP&gt;A storage device with an executable program stored thereon that instructs a processor to perform the filtration method.&lt;SEP&gt;A storage device containing executable program code for presenting digital media content, establishing user relationships, and determining relevancy weights, as described in claims 13-16.</data>
      <data key="d3">US9514753B2-chunk-001&lt;SEP&gt;US8719408B2-chunk-000&lt;SEP&gt;US8719408B2-chunk-001</data>
