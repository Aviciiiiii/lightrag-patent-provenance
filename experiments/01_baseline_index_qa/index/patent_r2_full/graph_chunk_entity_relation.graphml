    <node id="US8719408B2">
      <data key="d0">US8719408B2</data>
      <data key="d1">content</data>
      <data key="d2">A patent document titled "Automated digital media content filtration based on relationship monitoring" that describes methods and devices for filtering digital media content according to monitored user relationships.</data>
      <data key="d3">US8719408B2-chunk-000</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Automated Digital Media Content Filtration">
      <data key="d0">Automated Digital Media Content Filtration</data>
      <data key="d1">method</data>
      <data key="d2">A method for automatically filtering digital media content based on relationship monitoring, involving establishing user relationships, monitoring interactions, identifying published content, determining relevancy weights, and presenting prioritized content to a user.</data>
      <data key="d3">US8719408B2-chunk-000</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Content Producer">
      <data key="d0">Content Producer</data>
      <data key="d1">person</data>
      <data key="d2">An entity that publishes digital media content and has an online association with a user, forming the basis of a monitored user relationship.&lt;SEP&gt;A producer of digital media content who has a user relationship with a user, monitored via online associations and profile compatibility.</data>
      <data key="d3">US8719408B2-chunk-000&lt;SEP&gt;US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="User Relationship">
      <data key="d0">User Relationship</data>
      <data key="d1">concept</data>
      <data key="d2">A relationship established automatically according to a tolerance parameter, based on monitoring an online association between a user and a content producer.&lt;SEP&gt;A relationship between a user and a content producer established automatically according to a tolerance parameter, based on monitoring an online association, and possibly defined within a social networking internet site.</data>
      <data key="d3">US8719408B2-chunk-000&lt;SEP&gt;US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Tolerance Parameter">
      <data key="d0">Tolerance Parameter</data>
      <data key="d1">concept</data>
      <data key="d2">A parameter according to which a plurality of user relationships is automatically established.&lt;SEP&gt;A parameter according to which the relationship module automatically establishes user relationships.</data>
      <data key="d3">US8719408B2-chunk-000&lt;SEP&gt;US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Online Association">
      <data key="d0">Online Association</data>
      <data key="d1">concept</data>
      <data key="d2">An online connection between a user and a content producer that is monitored to establish and maintain user relationships.&lt;SEP&gt;An online association between a user and a content producer that is monitored to establish user relationships.</data>
      <data key="d3">US8719408B2-chunk-000&lt;SEP&gt;US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Relationship Interaction">
      <data key="d0">Relationship Interaction</data>
      <data key="d1">event</data>
      <data key="d2">An interaction within a determined user relationship that is monitored and used to derive a strength factor.</data>
      <data key="d3">US8719408B2-chunk-000</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Independent Server">
      <data key="d0">Independent Server</data>
      <data key="d1">artifact</data>
      <data key="d2">One of a plurality of independent servers with which the system interacts as a third party to identify digital media content published by content producers.</data>
      <data key="d3">US8719408B2-chunk-000</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Digital Media Content">
      <data key="d0">Digital Media Content</data>
      <data key="d1">content</data>
      <data key="d2">Media content published by content producers, comprising at least one digital media content item, that is identified, weighted, and presented to the user.&lt;SEP&gt;Media content items published by content producers that are filtered, ranked, and presented to users based on relevancy weights.</data>
      <data key="d3">US8719408B2-chunk-000&lt;SEP&gt;US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Digital Media Content Item">
      <data key="d0">Digital Media Content Item</data>
      <data key="d1">content</data>
      <data key="d2">An individual item of published digital media content for which a relevancy weight is determined.</data>
      <data key="d3">US8719408B2-chunk-000</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Relevancy Weight">
      <data key="d0">Relevancy Weight</data>
      <data key="d1">data</data>
      <data key="d2">A weight determined for each published digital media content item, based on a strength factor, used to prioritize content presented to the user.&lt;SEP&gt;A weight assigned to each published digital media content item based on a strength factor derived from monitored relationship interactions, used for filtering, ranking, and prioritizing content.</data>
      <data key="d3">US8719408B2-chunk-000&lt;SEP&gt;US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Strength Factor">
      <data key="d0">Strength Factor</data>
      <data key="d1">concept</data>
      <data key="d2">A factor derived from monitored relationship interactions between the user and the content producer, used as the basis for determining relevancy weight.&lt;SEP&gt;A factor derived at least in part from user-configurable weighing criteria and monitored relationship interactions, used to determine relevancy weights.</data>
      <data key="d3">US8719408B2-chunk-000&lt;SEP&gt;US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Media Aggregator">
      <data key="d0">Media Aggregator</data>
      <data key="d1">artifact</data>
      <data key="d2">A component to which a set of published digital media content items is pushed based on relevancy weights and a user-configurable relevancy threshold.&lt;SEP&gt;A media aggregator to which sets of published digital media content items are pushed based on relevancy weights and a user-configurable relevancy threshold.</data>
      <data key="d3">US8719408B2-chunk-000&lt;SEP&gt;US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Media Aggregator Profile">
      <data key="d0">Media Aggregator Profile</data>
      <data key="d1">data</data>
      <data key="d2">A profile associated with the user that defines the media aggregator and the user-configurable relevancy threshold.</data>
      <data key="d3">US8719408B2-chunk-000&lt;SEP&gt;US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="User-Configurable Relevancy Threshold">
      <data key="d0">User-Configurable Relevancy Threshold</data>
      <data key="d1">concept</data>
      <data key="d2">A user-configurable threshold used, together with relevancy weights, for pushing, filtering, or ranking digital media content items.&lt;SEP&gt;A user-configurable threshold used together with relevancy weights to filter or push sets of published digital media content items.</data>
      <data key="d3">US8719408B2-chunk-000&lt;SEP&gt;US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="User Profile">
      <data key="d0">User Profile</data>
      <data key="d1">data</data>
      <data key="d2">A profile of the user that is compared with a content producer profile to detect profile compatibility.&lt;SEP&gt;A profile of the user used for detecting profile compatibility with a content producer profile.</data>
      <data key="d3">US8719408B2-chunk-000&lt;SEP&gt;US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Content Producer Profile">
      <data key="d0">Content Producer Profile</data>
      <data key="d1">data</data>
      <data key="d2">A profile of a content producer that is compared with a user profile to detect profile compatibility.&lt;SEP&gt;A profile of a content producer used for detecting profile compatibility with a user profile.</data>
      <data key="d3">US8719408B2-chunk-000&lt;SEP&gt;US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Profile Compatibility">
      <data key="d0">Profile Compatibility</data>
      <data key="d1">concept</data>
      <data key="d2">Compatibility detected between a user profile and a content producer profile, used to modify the associated user relationship.&lt;SEP&gt;Compatibility between a user profile and a content producer profile, detected based at least in part on mutual interests, and used to modify the associated user relationship.</data>
      <data key="d3">US8719408B2-chunk-000&lt;SEP&gt;US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Mutual Interest">
      <data key="d0">Mutual Interest</data>
      <data key="d1">concept</data>
      <data key="d2">A shared interest between the user and a content producer, used at least in part to detect profile compatibility.</data>
      <data key="d3">US8719408B2-chunk-000</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Social Networking Internet Site">
      <data key="d0">Social Networking Internet Site</data>
      <data key="d1">artifact</data>
      <data key="d2">An internet site within which a plurality of user relationships may be defined.</data>
      <data key="d3">US8719408B2-chunk-000&lt;SEP&gt;US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="User-Configurable Weighing Criteria">
      <data key="d0">User-Configurable Weighing Criteria</data>
      <data key="d1">concept</data>
      <data key="d2">Criteria from which the strength factor is derived at least in part.&lt;SEP&gt;Criteria configurable by the user from which the strength factor is derived at least in part.</data>
      <data key="d3">US8719408B2-chunk-000&lt;SEP&gt;US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Executable Program">
      <data key="d0">Executable Program</data>
      <data key="d1">artifact</data>
      <data key="d2">A program stored on a computer-readable storage device that instructs a processor to perform the digital media content filtration steps.</data>
      <data key="d3">US8719408B2-chunk-000</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Apparatus For Automated Digital Media Content Filtration">
      <data key="d0">Apparatus For Automated Digital Media Content Filtration</data>
      <data key="d1">artifact</data>
      <data key="d2">An apparatus comprising a processor coupled to memory programmed to implement relationship, monitoring, detection, determination, and presentation modules for automated digital media content filtration based on relationship monitoring, as described in claim 17.</data>
      <data key="d3">US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Relationship Module">
      <data key="d0">Relationship Module</data>
      <data key="d1">method</data>
      <data key="d2">A module configured to establish automatically, according to a tolerance parameter, a plurality of user relationships, each based on monitoring an online association between a user and a content producer.</data>
      <data key="d3">US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Monitoring Module">
      <data key="d0">Monitoring Module</data>
      <data key="d1">method</data>
      <data key="d2">A module configured to monitor determined user relationships for relationship interactions.</data>
      <data key="d3">US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Detection Module">
      <data key="d0">Detection Module</data>
      <data key="d1">method</data>
      <data key="d2">A module configured to interact with a plurality of independent servers as a third party to identify digital media content published by content producers having a user relationship with the user.</data>
      <data key="d3">US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Determination Module">
      <data key="d0">Determination Module</data>
      <data key="d1">method</data>
      <data key="d2">A module configured to determine a relevancy weight for each published digital media content item based on a strength factor derived from monitored relationship interactions.</data>
      <data key="d3">US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Presentation Module">
      <data key="d0">Presentation Module</data>
      <data key="d1">method</data>
      <data key="d2">A module configured to present digital media content to the user such that content with greater relevancy weight receives higher priority.</data>
      <data key="d3">US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Independent Servers">
      <data key="d0">Independent Servers</data>
      <data key="d1">artifact</data>
      <data key="d2">A plurality of independent servers with which the detection module interacts as a third party to identify published digital media content.</data>
      <data key="d3">US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Relationship Interactions">
      <data key="d0">Relationship Interactions</data>
      <data key="d1">concept</data>
      <data key="d2">Interactions of determined user relationships that are monitored by the monitoring module and used to derive strength factors.</data>
      <data key="d3">US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Mutual Interests">
      <data key="d0">Mutual Interests</data>
      <data key="d1">concept</data>
      <data key="d2">One or more mutual interests between a user and a content producer used as a basis for detecting profile compatibility.</data>
      <data key="d3">US8719408B2-chunk-001</data>
      <data key="d4">US8719408B2.txt</data>
      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Translation-Based Query Pattern Mining">
      <data key="d0">Translation-Based Query Pattern Mining</data>
      <data key="d1">method</data>
      <data key="d2">A technique for mining query patterns by translating annotated queries from a first language into a second language and extracting a translated query pattern from the aligned translated collection of queries.</data>
      <data key="d3">US8655901B1-chunk-000</data>
      <data key="d4">US8655901B1.txt</data>
      <data key="d5">1793284615</data>
      <data key="d6" />
    </node>
    <node id="Query Pattern">
      <data key="d0">Query Pattern</data>
      <data key="d1">concept</data>
      <data key="d2">A pattern identifying a particular rule to interpret a particular type of query, expressed in a first language.&lt;SEP&gt;A rule identifying how to interpret a particular type of query, expressed in a first language and used to match queries in a query log.</data>
      <data key="d3">US8655901B1-chunk-000&lt;SEP&gt;US8655901B1-chunk-001</data>
      <data key="d4">US8655901B1.txt</data>
      <data key="d5">1793284615</data>
      <data key="d6" />
    </node>
    <node id="Translated Query Pattern">
      <data key="d0">Translated Query Pattern</data>
      <data key="d1">concept</data>
      <data key="d2">A query pattern in a second language extracted from a translated collection of annotated queries, used to interpret and search for queries in the second language.&lt;SEP&gt;A query pattern extracted from a translated collection of queries in a second language, used to interpret received queries in the second language.</data>
      <data key="d3">US8655901B1-chunk-000&lt;SEP&gt;US8655901B1-chunk-001</data>
      <data key="d4">US8655901B1.txt</data>
      <data key="d5">1793284615</data>
      <data key="d6" />
    </node>
    <node id="Query Log">
      <data key="d0">Query Log</data>
      <data key="d1">data</data>
      <data key="d2">A log of queries used to identify collections of queries matching a query pattern and to cross-validate translated query patterns against an occurrence threshold.&lt;SEP&gt;A collection of queries used to identify queries matching a query pattern and to cross-validate translated query patterns against a specified occurrence threshold.</data>
      <data key="d3">US8655901B1-chunk-000&lt;SEP&gt;US8655901B1-chunk-001</data>
      <data key="d4">US8655901B1.txt</data>
      <data key="d5">1793284615</data>
      <data key="d6" />
    </node>
    <node id="First Language">
      <data key="d0">First Language</data>
      <data key="d1">concept</data>
      <data key="d2">The language in which the original query pattern and collection of queries are expressed.&lt;SEP&gt;The language in which the original query pattern and the collection of matching queries are expressed.</data>
      <data key="d3">US8655901B1-chunk-000&lt;SEP&gt;US8655901B1-chunk-001</data>
      <data key="d4">US8655901B1.txt</data>
      <data key="d5">1793284618</data>
      <data key="d6" />
    </node>
    <node id="Second Language">
      <data key="d0">Second Language</data>
      <data key="d1">concept</data>
      <data key="d2">The language into which the annotated queries are translated and in which the translated query pattern is extracted.&lt;SEP&gt;The language into which the annotated collection of queries is translated and in which the translated query pattern is extracted.</data>
      <data key="d3">US8655901B1-chunk-000&lt;SEP&gt;US8655901B1-chunk-001</data>
      <data key="d4">US8655901B1.txt</data>
      <data key="d5">1793284618</data>
      <data key="d6" />
    </node>
    <node id="Query Component">
      <data key="d0">Query Component</data>
      <data key="d1">concept</data>
      <data key="d2">A part of a query resulting from applying a translated query pattern to split a received query, used to search a respective index.</data>
      <data key="d3">US8655901B1-chunk-000</data>
      <data key="d4">US8655901B1.txt</data>
      <data key="d5">1793284618</data>
      <data key="d6" />
    </node>
    <node id="Index">
      <data key="d0">Index</data>
      <data key="d1">data</data>
      <data key="d2">A searchable index corresponding to a query component, searched using resulting query components.&lt;SEP&gt;A respective search index for each query component used to search for results responsive to a received query.</data>
      <data key="d3">US8655901B1-chunk-000&lt;SEP&gt;US8655901B1-chunk-001</data>
      <data key="d4">US8655901B1.txt</data>
      <data key="d5">1793284618</data>
      <data key="d6" />
    </node>
    <node id="Search Results">
      <data key="d0">Search Results</data>
      <data key="d1">data</data>
      <data key="d2">Results responsive to a received query in the second language that are presented to a user.&lt;SEP&gt;Results responsive to a received query in the second language that are found using the translated query pattern and presented to a user.</data>
      <data key="d3">US8655901B1-chunk-000&lt;SEP&gt;US8655901B1-chunk-001</data>
      <data key="d4">US8655901B1.txt</data>
      <data key="d5">1793284618</data>
      <data key="d6" />
    </node>
    <node id="Computer-Readable Medium">
      <data key="d0">Computer-Readable Medium</data>
      <data key="d1">artifact</data>
      <data key="d2">A medium with which the one or more processors interact in order to perform the described operations.</data>
      <data key="d3">US8655901B1-chunk-000</data>
      <data key="d4">US8655901B1.txt</data>
      <data key="d5">1793284618</data>
      <data key="d6" />
    </node>
    <node id="Occurrence Threshold">
      <data key="d0">Occurrence Threshold</data>
      <data key="d1">concept</data>
      <data key="d2">A specified threshold used when cross-validating a translated query pattern with a query log.&lt;SEP&gt;A specified threshold with respect to which a translated query pattern is cross-validated with a query log.</data>
      <data key="d3">US8655901B1-chunk-000&lt;SEP&gt;US8655901B1-chunk-001</data>
      <data key="d4">US8655901B1.txt</data>
      <data key="d5">1793284618</data>
      <data key="d6" />
    </node>
    <node id="Query Components">
      <data key="d0">Query Components</data>
      <data key="d1">concept</data>
      <data key="d2">Parts of a query resulting from splitting a received query using a translated query pattern, each used to search a respective index.</data>
      <data key="d3">US8655901B1-chunk-001</data>
      <data key="d4">US8655901B1.txt</data>
      <data key="d5">1793284618</data>
      <data key="d6" />
    </node>
    <node id="Non-Transitory Computer Storage Medium">
      <data key="d0">Non-Transitory Computer Storage Medium</data>
      <data key="d1">artifact</data>
      <data key="d2">A storage medium encoded with a computer program whose instructions cause data processing apparatus to perform query pattern translation operations.&lt;SEP&gt;A storage medium encoded with computer program instructions that, when executed by processors, cause a computer device to perform operations for determining factual entities and displaying knowledge panel content.&lt;SEP&gt;A computer storage medium encoded with computer program instructions that cause a computer device to perform operations for determining factual entities and displaying related content.</data>
      <data key="d3">US8655901B1-chunk-001&lt;SEP&gt;US10867122B1-chunk-000&lt;SEP&gt;US10867122B1-chunk-001</data>
      <data key="d4">US8655901B1.txt&lt;SEP&gt;US10867122B1.txt</data>
      <data key="d5">1793284649</data>
      <data key="d6" />
    </node>
    <node id="Data Processing Apparatus">
      <data key="d0">Data Processing Apparatus</data>
      <data key="d1">artifact</data>
      <data key="d2">Apparatus that executes program instructions to perform the query pattern translation operations.&lt;SEP&gt;An apparatus that performs the claimed method of receiving content, determining factual entities, requesting knowledge panel content, and providing display instructions.</data>
      <data key="d3">US8655901B1-chunk-001&lt;SEP&gt;US10867122B1-chunk-000</data>
      <data key="d4">US8655901B1.txt&lt;SEP&gt;US10867122B1.txt</data>
      <data key="d5">1793284649</data>
      <data key="d6" />
    </node>
    <node id="Computing Devices">
      <data key="d0">Computing Devices</data>
      <data key="d1">artifact</data>
      <data key="d2">One or more devices forming a system that translates the collection of annotated queries.&lt;SEP&gt;One or more devices on or across which the stored program instructions are executed.</data>
      <data key="d3">US8655901B1-chunk-001&lt;SEP&gt;US11423041B2-chunk-001</data>
      <data key="d4">US8655901B1.txt&lt;SEP&gt;US11423041B2.txt</data>
      <data key="d5">1793284675</data>
      <data key="d6" />
    </node>
    <node id="US10867122B1">
      <data key="d0">US10867122B1</data>
      <data key="d1">content</data>
      <data key="d2">A patent document titled "Contextually relevant knowledge panels in an application environment" that describes methods and systems for determining factual entities from document content and displaying knowledge panels with related content.</data>
      <data key="d3">US10867122B1-chunk-000</data>
      <data key="d4">US10867122B1.txt</data>
      <data key="d5">1793284649</data>
      <data key="d6" />
    </node>
    <node id="Knowledge Panel">
      <data key="d0">Knowledge Panel</data>
      <data key="d1">concept</data>
      <data key="d2">A user interface element that provides a collection of content related to a factual entity, displayed contemporaneously with document content on a user device.</data>
      <data key="d3">US10867122B1-chunk-000</data>
      <data key="d4">US10867122B1.txt</data>
      <data key="d5">1793284649</data>
      <data key="d6" />
    </node>
    <node id="Factual Entity">
      <data key="d0">Factual Entity</data>
      <data key="d1">concept</data>
      <data key="d2">An entity determined from document content that relates to the content, used to request and populate a knowledge panel.</data>
      <data key="d3">US10867122B1-chunk-000</data>
      <data key="d4">US10867122B1.txt</data>
      <data key="d5">1793284649</data>
      <data key="d6" />
    </node>
    <node id="Display Environment">
      <data key="d0">Display Environment</data>
      <data key="d1">artifact</data>
      <data key="d2">An environment displayed on a user device into which a user types content, such as a document display environment displaying a document authored by the user.&lt;SEP&gt;A display area on the user device in which content is typed by a user; in some cases a document display environment displaying a document authored by the user.&lt;SEP&gt;A display environment that contains content and in which updated content is displayed via a user interface element.</data>
      <data key="d3">US10867122B1-chunk-000&lt;SEP&gt;US10867122B1-chunk-001&lt;SEP&gt;US10867122B1-chunk-002</data>
      <data key="d4">US10867122B1.txt</data>
      <data key="d5">1793284649</data>
      <data key="d6" />
    </node>
    <node id="User Device">
      <data key="d0">User Device</data>
      <data key="d1">artifact</data>
      <data key="d2">A computing device on which content and the display environment are displayed and to which instructions are provided to cause display of knowledge panel content.&lt;SEP&gt;A computing device used by a user that displays a display environment and a user interface element, receives typed content, and supplies input to an input element.&lt;SEP&gt;A device operated by a user that can supply input to an input element of the user interface element.</data>
      <data key="d3">US10867122B1-chunk-000&lt;SEP&gt;US10867122B1-chunk-001&lt;SEP&gt;US10867122B1-chunk-002</data>
      <data key="d4">US10867122B1.txt</data>
      <data key="d5">1793284649</data>
      <data key="d6" />
    </node>
    <node id="Input Cursor">
      <data key="d0">Input Cursor</data>
      <data key="d1">concept</data>
      <data key="d2">A cursor included in the display environment that indicates the position of input; content previously typed behind the input cursor is used to determine factual entities.&lt;SEP&gt;A cursor included in the display environment that indicates the current typing position, behind which previously typed content occurs.</data>
      <data key="d3">US10867122B1-chunk-000&lt;SEP&gt;US10867122B1-chunk-001</data>
      <data key="d4">US10867122B1.txt</data>
      <data key="d5">1793284649</data>
      <data key="d6" />
    </node>
    <node id="Level Of Intent">
      <data key="d0">Level Of Intent</data>
      <data key="d1">concept</data>
      <data key="d2">A measured value for a portion of typed content that is compared against a threshold level of intent to determine whether a second factual entity should be determined.</data>
      <data key="d3">US10867122B1-chunk-000</data>
      <data key="d4">US10867122B1.txt</data>
      <data key="d5">1793284649</data>
      <data key="d6" />
    </node>
    <node id="Threshold Level Of Intent">
      <data key="d0">Threshold Level Of Intent</data>
      <data key="d1">concept</data>
      <data key="d2">A threshold against which the measured level of intent for a portion of content is compared to trigger determination of a factual entity.&lt;SEP&gt;A threshold against which a measured level of intent for a portion of content is compared to determine whether to determine a factual entity.</data>
      <data key="d3">US10867122B1-chunk-000&lt;SEP&gt;US10867122B1-chunk-001</data>
      <data key="d4">US10867122B1.txt</data>
      <data key="d5">1793284649</data>
      <data key="d6" />
    </node>
    <node id="Computer Program Instructions">
      <data key="d0">Computer Program Instructions</data>
      <data key="d1">content</data>
      <data key="d2">Instructions encoded on a non-transitory computer storage medium that, when executed by one or more processors, cause a computer device to perform the described operations.&lt;SEP&gt;Instructions encoded on computer storage media that, when executed by processors, cause a computer device to perform operations.</data>
      <data key="d3">US10867122B1-chunk-000&lt;SEP&gt;US10867122B1-chunk-001</data>
      <data key="d4">US10867122B1.txt</data>
      <data key="d5">1793284649</data>
      <data key="d6" />
    </node>
    <node id="Input Element">
      <data key="d0">Input Element</data>
      <data key="d1">artifact</data>
      <data key="d2">An input element of the user interface element configured to receive input from the user device, allowing a portion of displayed content to be inserted into the display environment content.&lt;SEP&gt;An element of the user interface element configured to receive input from the user device.&lt;SEP&gt;An input element of the user interface element configured to receive input from the user device.</data>
