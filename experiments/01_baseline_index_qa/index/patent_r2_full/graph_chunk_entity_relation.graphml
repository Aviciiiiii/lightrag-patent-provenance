      <data key="d0">Cluster Deliverable Inventory Estimator</data>
      <data key="d1">artifact</data>
      <data key="d2">A component that determines a deliverable inventory estimate for a segment for each cluster to generate cluster-specific deliverable inventory estimates.</data>
      <data key="d3">US8880423B2-chunk-001</data>
