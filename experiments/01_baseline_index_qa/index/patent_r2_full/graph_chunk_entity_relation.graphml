    <node id="Member Image">
      <data key="d0">Member Image</data>
      <data key="d1">data</data>
      <data key="d2">An image associated with a member of the social networking service that includes a representation of a face of the respective member.&lt;SEP&gt;An image associated with a respective member within a member profile, including a representation of a face of the respective member.</data>
      <data key="d3">US8917913B2-chunk-000&lt;SEP&gt;US8917913B2-chunk-001</data>
      <data key="d4">US8917913B2.txt</data>
      <data key="d5">1793284306</data>
      <data key="d6" />
