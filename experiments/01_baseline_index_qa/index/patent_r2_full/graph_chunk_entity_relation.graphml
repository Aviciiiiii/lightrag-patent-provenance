      <data key="d1">data</data>
      <data key="d2">A profile associated with the social networking service corresponding to a member, including at least one member descriptor and at least one member image with a face representation.</data>
      <data key="d3">US8917913B2-chunk-000</data>
      <data key="d4">US8917913B2.txt</data>
      <data key="d5">1793284306</data>
      <data key="d6" />
    </node>
    <node id="Member Descriptor">
      <data key="d0">Member Descriptor</data>
      <data key="d1">data</data>
      <data key="d2">A descriptor associated with a respective member within a member profile, compared against a search term by the search service.</data>
      <data key="d3">US8917913B2-chunk-000</data>
      <data key="d4">US8917913B2.txt</data>
      <data key="d5">1793284306</data>
