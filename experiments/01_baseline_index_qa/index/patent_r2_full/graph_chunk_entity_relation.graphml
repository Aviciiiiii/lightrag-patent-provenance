    <node id="Device">
      <data key="d0">Device</data>
      <data key="d1">artifact</data>
      <data key="d2">The device that generated the short message and has a physical context to which the context data is related.</data>
      <data key="d3">US8509827B2-chunk-001</data>
      <data key="d4">US8509827B2.txt</data>
