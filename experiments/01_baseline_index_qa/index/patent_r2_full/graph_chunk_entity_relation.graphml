      <data key="d0">Internet Access Mechanism</data>
      <data key="d1">artifact</data>
      <data key="d2">A component associated with the mobile device that is in operative communication with the application and provides friend identifiers and face representations to the search service, and receives results back.&lt;SEP&gt;A mechanism associated with the mobile device that is in operative communication with the application and provides search terms and face representations to the search service.</data>
      <data key="d3">US8917913B2-chunk-000&lt;SEP&gt;US8917913B2-chunk-001</data>
      <data key="d4">US8917913B2.txt</data>
      <data key="d5">1793284306</data>
      <data key="d6" />
