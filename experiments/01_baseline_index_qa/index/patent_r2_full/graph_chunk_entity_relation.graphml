      <data key="d0">Extract, Transform, Load (ETL) Service</data>
      <data key="d1">organization</data>
      <data key="d2">A service that performs ETL processes and implements a data catalog for maintaining data lineage and detecting data events.</data>
      <data key="d3">US11423041B2-chunk-000</data>
      <data key="d4">US11423041B2.txt</data>
      <data key="d5">1793284674</data>
