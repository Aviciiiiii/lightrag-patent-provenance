    <node id="Interaction Volume">
      <data key="d0">Interaction Volume</data>
      <data key="d1">concept</data>
      <data key="d2">A characteristic of relevant interaction data representing the volume of interactions between two users, used in weighting and relationship modeling.</data>
      <data key="d3">US10778629B2-chunk-000</data>
      <data key="d4">US10778629B2.txt</data>
      <data key="d5">1793284708</data>
      <data key="d6" />
    </node>
    <node id="Relationship Strength">
      <data key="d0">Relationship Strength</data>
      <data key="d1">concept</data>
      <data key="d2">A measure determined for each pair of users based on weights assigned to characteristics of e-mail exchanges, based on intimacy of conversations, frequency of communications, and historical age of the relationship.&lt;SEP&gt;A measure determined for each pair of e-mail users based at least in part on the weights assigned to characteristics, forming the model of relationships.</data>
      <data key="d3">US10778629B2-chunk-000&lt;SEP&gt;US10778629B2-chunk-001</data>
