    <node id="Source">
      <data key="d0">Source</data>
      <data key="d1">other</data>
      <data key="d2">The source producing the data-stream, which may be a computer server, desktop computer, laptop computer, notebook computer, personal digital assistant, or source database.&lt;SEP&gt;The origin producing the data-stream, which may be a computer server, desktop computer, laptop computer, notebook computer, personal digital assistant, or source database.&lt;SEP&gt;An entity producing the data-stream, to which the receiving, extracting, and storing actions are transparent such that it is apparent the data-stream is being delivered to a backup storage device.&lt;SEP&gt;The producer of a data-stream, which may be a computer server, desktop computer, laptop computer, notebook computer, personal digital assistant, or source database.</data>
      <data key="d3">US7756837B2-chunk-000&lt;SEP&gt;US7756837B2-chunk-001&lt;SEP&gt;US7756837B2-chunk-002&lt;SEP&gt;US7756837B2-chunk-003</data>
      <data key="d4">US7756837B2.txt</data>
      <data key="d5">1793284549</data>
      <data key="d6" />
    </node>
    <node id="Volume">
      <data key="d0">Volume</data>
      <data key="d1">artifact</data>
      <data key="d2">A storage volume such as a computer disk drive or computer sub-drive, concerning which volume information is included in management data.&lt;SEP&gt;A unit of storage such as a computer disk drive or computer sub-drive, about which volume information such as size, space consumed, and space available is collected.&lt;SEP&gt;A unit of storage such as computer disk drives and computer sub-drives, with size, consumed space, and available space information.</data>
      <data key="d3">US7756837B2-chunk-000&lt;SEP&gt;US7756837B2-chunk-001&lt;SEP&gt;US7756837B2-chunk-002</data>
