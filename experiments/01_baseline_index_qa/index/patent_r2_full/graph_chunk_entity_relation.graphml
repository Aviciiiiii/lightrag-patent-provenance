    <node id="Direct Internet Access Protocol">
      <data key="d0">Direct Internet Access Protocol</data>
      <data key="d1">method</data>
      <data key="d2">A protocol through which data is obtained and the interaction database is populated.&lt;SEP&gt;A protocol through which e-mail exchange records are extracted from e-mail servers, transfer agents, or interaction databases.</data>
      <data key="d3">US10778629B2-chunk-000&lt;SEP&gt;US10778629B2-chunk-001</data>
