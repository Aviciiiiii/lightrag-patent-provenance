      <data key="d1">method</data>
      <data key="d2">An extract-transform-load process that is performed by the ETL service.&lt;SEP&gt;An Extract, Transform, Load process applied to one or more source data objects to generate one or more transformed data objects, whose performance is described by a history object instance.</data>
      <data key="d3">US11423041B2-chunk-001&lt;SEP&gt;US11423041B2-chunk-002</data>
      <data key="d4">US11423041B2.txt</data>
      <data key="d5">1793284675</data>
      <data key="d6" />
    </node>
