    <node id="ETL Process">
      <data key="d0">ETL Process</data>
      <data key="d1">method</data>
      <data key="d2">An Extract, Transform, Load process applied to source data objects to generate transformed data objects, whose performance is tracked and evaluated for triggering events.</data>
      <data key="d3">US11423041B2-chunk-000</data>
      <data key="d4">US11423041B2.txt</data>
      <data key="d5">1793284674</data>
