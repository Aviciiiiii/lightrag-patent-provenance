      <data key="d6" />
    </node>
    <node id="Metric">
      <data key="d0">Metric</data>
      <data key="d1">concept</data>
      <data key="d2">A measure used to algorithmically select relevant context data, comprising a monetary cost of the context-data.&lt;SEP&gt;A measure according to which relevant context data is algorithmically selected, comprising a monetary cost of the context-data.</data>
      <data key="d3">US8509827B2-chunk-000&lt;SEP&gt;US8509827B2-chunk-001</data>
      <data key="d4">US8509827B2.txt</data>
      <data key="d5">1793284123</data>
      <data key="d6" />
