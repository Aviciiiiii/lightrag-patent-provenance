    <node id="Query">
      <data key="d0">Query</data>
      <data key="d1">concept</data>
      <data key="d2">A query received from a party concerning the archived data-stream, used to formulate responses based on analysis of stored management data.&lt;SEP&gt;A request received from a party concerning archived data-streams, answered by analyzing the management data stored in the database.&lt;SEP&gt;A query received from a party concerning the archived data-stream, used to formulate responses.&lt;SEP&gt;A search query in a first or second language that is segmented into tokens, annotated, translated, and searched against indexes.&lt;SEP&gt;A search request that is segmented into tokens, annotated with labels, and translated as part of the query pattern mining process.</data>
      <data key="d3">US7756837B2-chunk-000&lt;SEP&gt;US7756837B2-chunk-001&lt;SEP&gt;US7756837B2-chunk-002&lt;SEP&gt;US8655901B1-chunk-000&lt;SEP&gt;US8655901B1-chunk-001</data>
      <data key="d4">US7756837B2.txt&lt;SEP&gt;US8655901B1.txt</data>
      <data key="d5">1793284618</data>
