      <data key="d5">1793284588</data>
      <data key="d6" />
    </node>
    <node id="Computer">
      <data key="d0">Computer</data>
      <data key="d1">artifact</data>
      <data key="d2">A computing machine that executes stored instructions to perform operations.</data>
      <data key="d3">US9514753B2-chunk-001</data>
      <data key="d4">US9514753B2.txt</data>
      <data key="d5">1793284146</data>
      <data key="d6" />
    </node>
    <node id="System">
      <data key="d0">System</data>
      <data key="d1">artifact</data>
      <data key="d2">A system comprising one or more computers and a computer-readable storage device storing instructions.&lt;SEP&gt;A computing system comprising one or more processors configured to interact with a computer-readable medium to perform query pattern mining operations.&lt;SEP&gt;A system comprising one or more processors configured to execute computer program instructions and computer storage media encoded with such instructions.&lt;SEP&gt;A system that performs operations including causing display of updated content in a user interface element and inserting content into a display environment.</data>
      <data key="d3">US9514753B2-chunk-001&lt;SEP&gt;US8655901B1-chunk-000&lt;SEP&gt;US10867122B1-chunk-001&lt;SEP&gt;US10867122B1-chunk-002</data>
      <data key="d4">US9514753B2.txt&lt;SEP&gt;US8655901B1.txt&lt;SEP&gt;US10867122B1.txt</data>
