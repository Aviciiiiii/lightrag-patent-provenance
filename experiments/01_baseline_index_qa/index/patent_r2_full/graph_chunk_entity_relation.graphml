    <node id="Page View Probability Vector">
      <data key="d0">Page View Probability Vector</data>
      <data key="d1">data</data>
      <data key="d2">A vector generated for each viewed page indicating the probabilities of the corresponding viewed page being included in each of the clusters.</data>
      <data key="d3">US8880423B2-chunk-000</data>
      <data key="d4">US8880423B2.txt</data>
      <data key="d5">1793284279</data>
      <data key="d6" />
    </node>
    <node id="Keyword Probability Vector">
      <data key="d0">Keyword Probability Vector</data>
      <data key="d1">data</data>
      <data key="d2">A vector generated for each search keyword indicating the probabilities of the corresponding keyword being included in each of the clusters.</data>
      <data key="d3">US8880423B2-chunk-000</data>
      <data key="d4">US8880423B2.txt</data>
      <data key="d5">1793284279</data>
      <data key="d6" />
    </node>
    <node id="Total Inventory">
      <data key="d0">Total Inventory</data>
      <data key="d1">data</data>
      <data key="d2">An estimated total inventory for each cluster, generated by summing the probabilities included in the page view probability vectors for the cluster.</data>
      <data key="d3">US8880423B2-chunk-000</data>
      <data key="d4">US8880423B2.txt</data>
      <data key="d5">1793284279</data>
      <data key="d6" />
    </node>
    <node id="Deliverable Inventory">
      <data key="d0">Deliverable Inventory</data>
      <data key="d1">data</data>
      <data key="d2">The inventory estimated as deliverable for a search retargeting segment.&lt;SEP&gt;An estimate of deliverable advertisement inventory for a received search retargeting segment, based on the estimated total inventories for the clusters.</data>
      <data key="d3">US8880423B2-chunk-000&lt;SEP&gt;US8880423B2-chunk-001</data>
      <data key="d4">US8880423B2.txt</data>
      <data key="d5">1793284279</data>
      <data key="d6" />
    </node>
    <node id="Cluster-Specific Deliverable Inventory Estimate">
      <data key="d0">Cluster-Specific Deliverable Inventory Estimate</data>
      <data key="d1">data</data>
      <data key="d2">A deliverable inventory estimate for a segment determined for each cluster, generated by summing keyword probabilities for the cluster and multiplying by the cluster's estimated total inventory.</data>
      <data key="d3">US8880423B2-chunk-000</data>
      <data key="d4">US8880423B2.txt</data>
      <data key="d5">1793284279</data>
