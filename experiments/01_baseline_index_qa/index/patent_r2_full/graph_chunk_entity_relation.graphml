      <data key="d0">Third Party Backup Data Product</data>
      <data key="d1">artifact</data>
      <data key="d2">A backup data product whose data-stream protocol forms the basis of a predetermined rule set.&lt;SEP&gt;A backup product whose data-stream protocol forms the basis of a predetermined rule set used to recognize distinct data sets.&lt;SEP&gt;A product whose data-stream protocol forms the basis of a predetermined rule set.</data>
      <data key="d3">US7756837B2-chunk-000&lt;SEP&gt;US7756837B2-chunk-001&lt;SEP&gt;US7756837B2-chunk-002</data>
      <data key="d4">US7756837B2.txt</data>
