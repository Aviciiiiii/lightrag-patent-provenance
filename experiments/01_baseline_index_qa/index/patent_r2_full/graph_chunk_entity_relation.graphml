    <node id="Intensity Value">
      <data key="d0">Intensity Value</data>
      <data key="d1">concept</data>
      <data key="d2">A value of search keywords present in viewed pages used together with time-decaying weighted frequency for clustering.&lt;SEP&gt;A value of search keywords present in viewed pages used, along with time-decaying weighted frequency, as a basis for clustering.</data>
      <data key="d3">US8880423B2-chunk-000&lt;SEP&gt;US8880423B2-chunk-001</data>
      <data key="d4">US8880423B2.txt</data>
      <data key="d5">1793284279</data>
