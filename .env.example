# Copy to .env (same directory) and fill in your own keys. .env is git-ignored.
# The original runs used SiliconFlow's OpenAI-compatible endpoint.
LLM_BINDING_HOST=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
LLM_BINDING_API_KEY=

EMBEDDING_BINDING_HOST=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BINDING_API_KEY=
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
